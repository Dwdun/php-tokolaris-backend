{
    "name": "tokolaris/shop-legacy-backend",
    "description": "Legacy Monolith E-Commerce Backend for Bootcamp Simulation",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Kunci\\": "kunci/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "uji/tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "^1.11",
        "rector/rector": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --level=5 app"
    }
}
